# Optional — leave unset for pure local-first mode (recommended until multi-user auth is live)
VITE_AUTH_ENABLED=true

# Required for Better Auth + remote Postgres (e.g. Neon)
# DATABASE_URL=postgresql://user:pass@host/db
# BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# BETTER_AUTH_URL=https://your-production-domain.vercel.app

# Never commit real secrets. This file is safe to commit as an example.
