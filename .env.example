# Optional — leave unset for pure local-first mode (recommended for the core card)
VITE_AUTH_ENABLED=false

# Required only when enabling Better Auth + remote Postgres (e.g. Neon)
# DATABASE_URL=postgresql://user:pass@host/db
# BETTER_AUTH_SECRET=generate-a-long-random-string

